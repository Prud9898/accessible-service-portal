@model IReadOnlyList<ServiceRequest>
@{
    ViewData["Title"] = "Requests";
}
<h1>Service requests</h1>
<p>Explore submitted requests or create a new request using an accessible form.</p>
@if (TempData["Success"] is string message)
{
    <div class="notice success" role="status" aria-live="polite">@message</div>
}
<p><a class="button" asp-action="Create">Submit a new request</a></p>
<h2>Recent requests</h2>
@if (Model.Count == 0)
{
    <p>No requests have been submitted yet.</p>
}
else
{
    <div class="table-scroll" role="region" aria-label="Recent requests table" tabindex="0">
        <table>
            <caption>Requests submitted during this application session</caption>
            <thead><tr><th scope="col">ID</th><th scope="col">Category</th><th scope="col">Submitted (UTC)</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr><th scope="row">@item.Id</th><td>@item.Category</td><td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td></tr>
            }
            </tbody>
        </table>
    </div>
}
