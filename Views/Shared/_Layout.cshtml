<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Accessible Service Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <div class="container">
            <div class="brand">Accessible Service Portal</div>
            <nav aria-label="Primary navigation">
                <a asp-controller="Requests" asp-action="Index">Requests</a>
                <a asp-controller="Requests" asp-action="Create">Submit a request</a>
            </nav>
        </div>
    </header>
    <main id="main-content" class="container" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container">Original demonstration project • Not a client application</div></footer>
</body>
</html>
